{
  "name": "browser",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.yourname.browser",
    "productName": "Browser",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "styles.css", "renderer.js"],
    "win": {
      "target": "portable",
      "artifactName": "Browser.exe"
    }
  }
}
