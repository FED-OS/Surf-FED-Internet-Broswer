{
  "name": "Surf-FED",
  "version": "1.0.0",
  "description": "Custom Electron browser with tabs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.yourname.electronbrowser",
    "productName": "Surf-FED",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
